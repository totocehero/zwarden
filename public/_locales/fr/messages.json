  "settingsAutoLock": {
    "message": "Verrouillage automatique après inactivité"
  },
  "settingsAutoLockHint": {
    "message": "« Inactivité » : aucun changement d’onglet, de fenêtre ni de page, et popup fermée. Naviguer suffit donc à garder le coffre ouvert. Le verrouillage peut tarder d’une minute sur le délai choisi. À la fermeture du navigateur, le coffre est de toute façon verrouillé : la clé ne vit qu’en mémoire."
  },
  "settingsLockOnSystemLock": {
    "message": "Verrouiller aussi quand la session de l’ordinateur se verrouille"
  },
  "settingsLockOnSystemLockHint": {
    "message": "Écran de verrouillage, veille, « Win+L » : le coffre se verrouille immédiatement, quel que soit le délai ci-dessus. S’éloigner de sa machine est plus fréquent que fermer son navigateur."
  },
  "settingsClipboard": {
    "message": "Effacement du presse-papiers après une copie"
  },
  "settingsClipboardHint": {
    "message": "Deux effacements s’en chargent : un minuteur qui respecte le délai exact tant que la popup est ouverte, et une alarme qui lui survit mais que Chrome ramène à trente secondes minimum."
  },
