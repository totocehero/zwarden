{
  "manifest_version": 3,
  "name": "Zwarden",
  "version": "0.1.0",
  "description": "Open-source password manager, compatible with Vaultwarden / the Bitwarden API. Built to stay light.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Zwarden",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms",
    "idle",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+U"
      },
      "description": "Open Zwarden"
    },
    "generate-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Generate a password and copy it"
    },
    "lock-vault": {
      "description": "Lock the vault"
    }
  }
}
