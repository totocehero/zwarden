{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "0.1.0",
  "description": "__MSG_appDescription__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png"
    },
    "theme_icons": [
      {
        "light": "images/icon16.png",
        "dark": "images/icon16-dark.png",
        "size": 16
      },
      {
        "light": "images/icon32.png",
        "dark": "images/icon32-dark.png",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms",
    "idle",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+U"
      },
      "description": "__MSG_cmdOpen__"
    },
    "generate-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "__MSG_cmdGenerate__"
    },
    "lock-vault": {
      "description": "__MSG_cmdLock__"
    }
  }
}
